ASCOG_IDS_FILE =  f"{RESULT_DIR}/ascog_ids.txt"
MAPPING_FILE = f"{RESULT_DIR}/pfam_mapping.tsv"

inclue: "bin/pipelines/hmmsearch_pipeline/rules/jackhmmer.smk"


