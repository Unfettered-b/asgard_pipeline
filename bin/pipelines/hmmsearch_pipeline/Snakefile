
import os
from pathlib import Path
from datetime import datetime

shell.executable("/bin/bash")

if not config:
    raise ValueError("no config provided, use --configfile")

# -------------------------------
# CONFIG
# -------------------------------

TIMESTAMP = datetime.now().strftime("%Y%m%d_%H%M%S")
RUN_ID = config.get("run").get("id", TIMESTAMP)

BASE_DIR = config["run"]["base_dir"]
PROJECT_NAME = config['run']['protein_name']
CURRENT_DIR = config.get("run", {}).get('base_dir', workflow.basedir)
RESULT_DIR = Path(f"{BASE_DIR}/database/protein_sets/{PROJECT_NAME}/{RUN_ID}")
JACKHMMER_DIR=f"{RESULT_DIR}/jackhmmer"
RESULT_DIR = RESULT_DIR /"hmmsearch"

PFAM_DB = config["inputs"]["pfam"]["hmm_db"].format(base_dir=BASE_DIR)
PFAM_NAMES = config["inputs"]["pfam"]["names"]
DB = config["inputs"]["database"]["fasta"].format(base_dir=BASE_DIR)
ASCOGS = config["inputs"]["database"]["AsCOGs"].format(base_dir=BASE_DIR)
ASCOGS_TSV = config["inputs"]['database']['ascogs_tsv'].format(base_dir=BASE_DIR)
ENV_DIR = config["run"]["env_dir"].format(base_dir=BASE_DIR)
DATABASE_DIR = config["inputs"]["database"]["AsCOGs_dir"].format(base_dir=BASE_DIR)

EVALUE = config["params"]["evalue"]
CPUS = config["params"]["cpus"]

