# -------------------------------
# Download Pfam DB (if missing)
# -------------------------------
rule download_pfam:
    output:
        PFAM_DB
    conda:
        f"{ENV_DIR}/Reg.yaml"
    shell:
        r"""
        mkdir -p $(dirname {output})
        wget -qO- https://ftp.ebi.ac.uk/pub/databases/Pfam/current_release/Pfam-A.hmm.gz \
            | gunzip -c > {output}
        """


rule download_ascogs:
    output:
        definitions=f"{DATABASE_DIR}/asCOGs.2020-10.def.tab",
        alignment=directory(f"{DATABASE_DIR}/ali.8"),
    params:
        # Confirmed current filenames (checked in browser, 2026-08-10):
        # https://ftp.ncbi.nih.gov/pub/wolf/COGs/arCOG/asgard20/
        #   asCOGs.2020-10.def.tab   <- definitions (unchanged, was already correct)
        #   asCOG.ali.tgz            <- alignment archive (renamed from ali.8.tar.gz)
        #   asCOGs.2023-05.csv       <- newer alternative definitions format, unused here
        #   asgard.seq.tgz           <- raw sequences, unused here
        urls_alignment=[
            "https://ftp.ncbi.nih.gov/pub/wolf/COGs/arCOG/asgard20/asCOG.ali.tgz",
        ],
        urls_definitions=[
            "https://ftp.ncbi.nih.gov/pub/wolf/COGs/arCOG/asgard20/asCOGs.2020-10.def.tab",
        ],
    shell:
        r"""
        set -euo pipefail

        def_out="{output.definitions}"
        ali_out="{output.alignment}"
        db_dir=$(dirname "$def_out")
        tmpdir="${{db_dir}}/.tmp.download_ascogs.$$"

        cleanup() {{ rm -rf "$tmpdir"; }}
        trap cleanup EXIT

        rm -rf "$tmpdir"
        mkdir -p "$tmpdir/extracted" "$db_dir"

        # fetch_first_working <output_path> <url1> [url2] [url3] ...
        # Tries each URL with a HEAD request first (fast, no download) to
        # confirm it resolves before spending time on the real transfer.
        fetch_first_working() {{
            local out="$1"; shift
            local url ok=0
            for url in "$@"; do
                echo "  trying: $url"
                if curl -fsSL -o /dev/null --head \
                        --connect-timeout 15 --max-time 20 "$url" 2>/dev/null; then
                    echo "  -> reachable, downloading"
                    if curl -fSL --retry 5 --retry-delay 5 --retry-connrefused \
                            --connect-timeout 30 -o "$out" "$url"; then
                        ok=1
                        break
                    else
                        echo "  -> HEAD ok but GET failed, trying next candidate"
                    fi
                else
                    echo "  -> not reachable (404 or similar), trying next candidate"
                fi
            done
            if [ "$ok" -ne 1 ]; then
                echo "ERROR: none of the candidate URLs worked for $out:" >&2
                printf '  %s\n' "$@" >&2
                echo "Check https://ftp.ncbi.nih.gov/pub/wolf/COGs/arCOG/asgard20/" >&2
                echo "and https://ftp.ncbi.nih.gov/pub/wolf/_suppl/asgard20/ in a browser" >&2
                echo "for the current filenames, then update params.urls_* accordingly." >&2
                exit 1
            fi
        }}

        echo "Downloading AsCOG alignment archive..."
        fetch_first_working "$tmpdir/asCOG.ali.tgz" {params.urls_alignment}

        echo "Downloading AsCOG definitions..."
        fetch_first_working "$tmpdir/asCOGs.2020-10.def.tab" {params.urls_definitions}

        echo "Validating archive..."
        tar -tzf "$tmpdir/asCOG.ali.tgz" > /dev/null

        echo "Validating definitions file..."
        [ -s "$tmpdir/asCOGs.2020-10.def.tab" ]
        if head -c 200 "$tmpdir/asCOGs.2020-10.def.tab" | grep -qi '<!DOCTYPE\|<html'; then
            echo "ERROR: definitions file looks like an HTML error page, not real data" >&2
            exit 1
        fi

        echo "Extracting AsCOGs alignment..."
        tar -xzf "$tmpdir/asCOG.ali.tgz" -C "$tmpdir/extracted"

        # Handle whichever layout the archive actually uses: a top-level
        # "ali.8/" dir (old naming, may still be used inside the tarball
        # even though the tarball itself was renamed), files dumped flat,
        # or some other single top-level directory. We don't hardcode an
        # assumption here -- if there's exactly one subdirectory, use it;
        # otherwise assume flat layout.
        if [ -d "$tmpdir/extracted/ali.8" ]; then
            ali_src="$tmpdir/extracted/ali.8"
        else
            n_subdirs=$(find "$tmpdir/extracted" -mindepth 1 -maxdepth 1 -type d | wc -l)
            n_topfiles=$(find "$tmpdir/extracted" -mindepth 1 -maxdepth 1 -type f | wc -l)
            if [ "$n_subdirs" -eq 1 ] && [ "$n_topfiles" -eq 0 ]; then
                ali_src=$(find "$tmpdir/extracted" -mindepth 1 -maxdepth 1 -type d)
                echo "  archive has single top-level dir: $(basename "$ali_src")"
            else
                ali_src="$tmpdir/extracted"
            fi
        fi

        n_files=$(find "$ali_src" -type f | wc -l)
        if [ "$n_files" -eq 0 ]; then
            echo "ERROR: extracted alignment directory is empty" >&2
            echo "Archive layout was unexpected -- inspect $tmpdir/extracted manually" >&2
            exit 1
        fi
        echo "Found $n_files alignment files."

        echo "Installing database (atomic swap)..."
        rm -rf "$ali_out"
        mv "$ali_src" "$ali_out"
       iconv -f WINDOWS-1252 -t UTF-8 "$tmpdir/asCOGs.2020-10.def.tab" -o "$tmpdir/asCOGs.2020-10.def.tab.utf8" \
    && mv "$tmpdir/asCOGs.2020-10.def.tab.utf8" "$tmpdir/asCOGs.2020-10.def.tab"
        mv "$tmpdir/asCOGs.2020-10.def.tab" "${{def_out}}.tmp"
        mv "${{def_out}}.tmp" "$def_out"      

        echo "AsCOG database installed successfully."
        """

